{
  "name": "react-express-socketio",
  "version": "1.0.0",
  "main": "server/index.ts",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "node --watch --watch-preserve-output server/index.ts",
    "build": "pnpm --filter frontend run build",
    "start": "node server/index.ts",
    "test": "vitest run && pnpm --filter frontend test",
    "typecheck": "tsc --noEmit && pnpm --filter frontend run typecheck"
  },
  "keywords": [],
  "author": "Emiliano Sasal",
  "license": "ISC",
  "description": "Chat app using React, Express, and Socket.io",
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
